# .env.example — IRIS Credentials Template
# ==========================================
# Copy this file to .env and fill in your real values.
# The .env file is gitignored — never commit real credentials.
#
#   cp .env.example .env
#   # then edit .env with your actual keys
#
# IRIS works in fully deterministic (offline) mode if these are left blank.
# Fill them in to enable IBM Granite LLM explanations and mitigation rationale.

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Get these from https://cloud.ibm.com → watsonx.ai → Project Settings
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── Granite Model IDs (optional overrides) ────────────────────────────────────
# Primary model — fast, low-cost
GRANITE_MODEL=ibm/granite-4-0-tiny-preview
# Fallback model — used automatically if primary fails (hardcoded in agent_system.py)
# GRANITE_MODEL_FALLBACK=ibm/granite-3-8b-instruct

# ── MCP Server (optional) ────────────────────────────────────────────────────
# Uncomment to change the MCP server port (default: stdio transport)
# MCP_PORT=8765
