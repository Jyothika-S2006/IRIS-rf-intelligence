              "description": {
                "value": "Apply DSP mitigation (notch/bandpass/blanking) to signal, re-run detection, return before/after SNR and anomaly score.",
                "type": "str"
              },
              "code": {
                "value": "from agent_tools import apply_mitigation, re_run_detection\nimport numpy as np, json\ndef apply_and_verify(sample_id: str, interference_type: str) -> str:\n    from data_loader import load_iq_by_id\n    iq = load_iq_by_id(sample_id)\n    mit = apply_mitigation(iq, interference_type)\n    ver = re_run_detection(iq, mit['filtered_iq'], sample_id)\n    return json.dumps({'strategy': mit['strategy'], 'params': mit['params'], 'verification': ver})\n",
                "type": "code"
              }
            },
